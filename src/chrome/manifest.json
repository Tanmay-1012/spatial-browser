{
  "manifest_version": 3,
  "name": "Spatial Browser History",
  "version": "0.1.0",
  "description": "Retrace research and browsing paths through an interactive spatial node graph.",
  "minimum_chrome_version": "109",
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Spatial Browser History",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
