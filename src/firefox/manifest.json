{
  "manifest_version": 3,
  "name": "Spatial Browser History",
  "version": "0.1.0",
  "description": "Retrace research and browsing paths through an interactive spatial node graph.",
  "browser_specific_settings": {
    "gecko": {
      "id": "spatial-browser-history@term-project.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "downloads"
  ],
  "background": {
    "scripts": [
      "launch.js",
      "storage.js",
      "tracker.js",
        "background-messages.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Spatial Browser History",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
